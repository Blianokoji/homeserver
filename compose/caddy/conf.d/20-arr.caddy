# ==============================================================================
# 20-arr.caddy: Media Automation Suite (*arr Suite)
# Administrative Only - Restricted to group:admins and Local LAN
# ==============================================================================

# Radarr (Movies)
radarr.{$TAILSCALE_DOMAIN:homeserver.ts.net}, radarr.home.arpa, radarr.homeserver {
    import common_headers
    import admin_only
    import tls_internal

    reverse_proxy radarr:7878
}

# Sonarr (TV Shows)
sonarr.{$TAILSCALE_DOMAIN:homeserver.ts.net}, sonarr.home.arpa, sonarr.homeserver {
    import common_headers
    import admin_only
    import tls_internal

    reverse_proxy sonarr:8989
}

