# ==============================================================================
# 10-media.caddy: Media Hub (Jellyfin, Jellyseerr, Immich)
# Permitted for group:media-users, group:admins, and Local LAN
# ==============================================================================

# Jellyfin (Media Streaming)
jellyfin.{$TAILSCALE_DOMAIN:homeserver.ts.net}, jellyfin.home.arpa, jellyfin.homeserver {
    import common_headers
    import tls_internal

    # Cache static assets at the proxy edge to reduce Jellyfin roundtrips
    @static {
        path *.js *.css *.woff *.woff2 *.ttf *.ico *.png *.svg *.jpg *.webp
    }
    header @static Cache-Control "public, max-age=31536000, immutable"

    reverse_proxy jellyfin:8096 {
        transport http {
            # 4MB read buffer — HLS segments are 2-8MB, 8KB was killing throughput
            read_buffer  4194304
            # 256KB write buffer for upstream request bodies
            write_buffer 262144
            # Generous timeouts for long-lived HLS streaming sessions
            dial_timeout         10s
            response_header_timeout 30s
            read_timeout         0s
            write_timeout        0s
        }
        # Pass real client IP to Jellyfin for access logs / geo
        header_up X-Real-IP {remote_host}
    }
}

# Jellyseerr (Media Discovery & Requests)
jellyseerr.{$TAILSCALE_DOMAIN:homeserver.ts.net}, jellyseerr.home.arpa, jellyseerr.homeserver {
    import common_headers
    import tls_internal

    reverse_proxy host.docker.internal:5055
}

# Immich (Photos & Videos Cloud)
immich.{$TAILSCALE_DOMAIN:homeserver.ts.net}, immich.home.arpa, immich.homeserver {
    import common_headers
    import tls_internal

    request_body {
        max_size 50GB
    }

    reverse_proxy immich_server:2283
}
